import java.util.Arrays;

public class SortInAssending {
	public static void main(String[] args) {
		int arr[]= {3,5,9,7,2,4,8};
		int temp=0;
		for(int i=0;i<arr.length;i++) {
			for(int j=1;j<arr.length;j++) {
				if(arr[i]>arr[j]) {
					temp=arr[i];
					arr[i]=arr[j];
					arr[j]=temp;
				}
				
			}
		}
		System.out.println(Arrays.toString(arr));
	}
}
