
public class Palindrom {
	public static void main(String[] args) {
		String s="mama";
		int left=0;
		int right=s.length()-1;
		boolean isPalindrom=false;
		for(int i=0;i<s.length();i++) {
			if(s.charAt(left) == s.charAt(right)) {
				isPalindrom=true;
				break;
			}else {
				isPalindrom =false;
			}
		}
		System.out.println(isPalindrom);
	}
}
