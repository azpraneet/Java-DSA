

import java.util.Scanner;

public class Demo {
	public static void main(String[] args) {
	int[] ar= {8,2,5,8,3};
	int temp =0;
	for(int i=0;i<ar.length;i++) {
		for(int j=i+1;i<ar.length;i++) {
			if(ar[i]<ar[j]) {
				temp=ar[i];
				ar[i]=ar[j];
				ar[j]=temp;
			}
		}
		System.out.println(ar[i]);
	}
	
	}
}
