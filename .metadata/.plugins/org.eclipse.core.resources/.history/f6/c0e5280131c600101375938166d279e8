import java.util.Arrays;

public class SortInAssending {
	public static void main(String[] args) {
		int arr[]= {3,5,9,7,2,4,8};
		for(int i=0;i<arr.length;i++) {
			System.out.print(arr[i]);
		}
		System.out.println();
		for(int x:arr) {
			System.out.print(x);
		}
		System.out.println(Arrays.toString(arr));
	}
}
