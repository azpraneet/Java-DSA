import java.util.Scanner;

public class Prime {
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter a Number");
		int n = sc.nextInt();
		boolean isPrime=false;
		if(n==1 || n==2 || n==3) {
			isPrime=true;
		}else {
			for(int i=2;i<n;i++) {
				if(n%1==0) {
					isPrime=false;
					break;
				}else{
					isPrime=true;
				}
			}
		}
		System.out.println(isPrime);
	}
}