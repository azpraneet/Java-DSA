

import java.util.Scanner;

public class Demo {
	public static void main(String[] args) {
	int[] ar= {8,2,5,8,3};
	int min=ar[0];
	int max=ar[0];
	for(int i=0;i<ar.length;i++) {
		for(int j=i+1;i<ar.length;i++) {
			if(ar[i]<min) {
				min=ar[i];
			}
			if(ar[i]>max) {
				max=ar[i];
			}
		}
	}
	System.out.println("min is :"+min);
	System.out.println("max is :"+max);
	}
}
