
public class MinMax {
	public static void main(String[] args) {
		int[] arr= {4,2,9,3,7,6};
		int min=0;
		int max=0;
		for(int i=0;i<arr.length;i++) {
			if(arr[i]<min) {
				 min=arr[i];
			}else {
				if(arr[i]>max) {
					max=arr[i];
				}
			}
		}
		System.out.println(min);
		System.out.println(max);
	}
}
